{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/episodes.schema.json",
  "title": "Podcast Episodes (Mocked)",
  "type": "array",
  "minItems": 20,
  "maxItems": 20,
  "items": { "$ref": "#/$defs/Episode" },
  "unevaluatedItems": false,
  "contains": {
    "type": "object",
    "required": ["featured"],
    "properties": { "featured": { "const": true } }
  },
  "minContains": 1,
  "maxContains": 1,
  "$defs": {
    "Episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "description",
        "publishedAt",
        "durationSeconds",
        "coverImage",
        "audioSrc",
        "featured"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "durationSeconds": { "type": "integer", "minimum": 1 },
        "coverImage": { "type": "string", "minLength": 1 },
        "audioSrc": { "type": "string", "minLength": 1 },
        "featured": { "type": "boolean" },
        "season": { "type": "integer", "minimum": 1 },
        "episodeNumber": { "type": "integer", "minimum": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
